# ============ 模型配置 ============
# 可选: dashscope / openai / mock
# 不配置时自动判断: 有 DASHSCOPE_API_KEY 用 dashscope，否则有 OPENAI_API_KEY 用 openai，
# 都没有则回退到内置离线 mock 模型（无网络依赖，用于体验完整流程）
MODEL_PROVIDER=

# DashScope（通义千问，推荐中文客服场景）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# OpenAI / OpenAI 兼容端点（可指向任意 base_url）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ============ RAG 知识库检索配置 ============
# 向量化后端: dashscope / none
# 留空则自动判断: 有 DASHSCOPE_API_KEY 用 dashscope，否则 none（退回纯词面检索，离线仍可跑）
EMBED_PROVIDER=
# Embedding 模型名（DashScope OpenAI 兼容端点）
EMBED_MODEL=qwen3.7-text-embedding-flash
# 兼容端点 base_url，默认阿里云百炼
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次 Embedding 请求超时（秒）与批量条数上限
EMBED_TIMEOUT=15
EMBED_BATCH_SIZE=10
# 最终返回的知识条数，以及混合得分下限（低于视为未命中）
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
# 稠密向量权重 alpha（0~1），(1-alpha) 为词面关键词权重
RAG_ALPHA=0.7

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
# 会话闲置多久后回收（分钟）
SESSION_TTL_MINUTES=120
# 单个会话最大保留在内存中的数量
MAX_SESSIONS=200

# ============ 品牌配置 ============
# 商城品牌名与客服展示名，留空则用代码默认值
BRAND_NAME=Volcano
AGENT_NAME=小V

# ============ 上下文与推理轮次策略 ============
# 上下文占模型窗口的比例超过 CONTEXT_TRIGGER_RATIO 时触发压缩（SDK 上限 0.9）
CONTEXT_TRIGGER_RATIO=0.7
# 压缩后保留的上下文比例，必须小于 CONTEXT_TRIGGER_RATIO
CONTEXT_RESERVE_RATIO=0.2
# 压缩阈值之前的预警缓冲区，必须小于 CONTEXT_TRIGGER_RATIO
CONTEXT_BUFFER_RATIO=0.15
# 单条工具结果的 token 上限，超出即截断
TOOL_RESULT_LIMIT=4000
# 一轮回复内最多的"推理-行动"轮次
MAX_REACT_ITERS=12
# 单轮回复的加权 token 预算（输入+输出）；超出后注入收尾提示并禁用工具
REPLY_TOKEN_BUDGET=32000
# 输出 token 的权重（通常比输入贵），用于加权计算预算消耗
REPLY_OUTPUT_TOKEN_WEIGHT=2.0