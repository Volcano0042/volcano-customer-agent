# ============ 模型配置 ============
# 可选: dashscope / openai / mock
# 不配置时自动判断: 有 DASHSCOPE_API_KEY 用 dashscope，否则有 OPENAI_API_KEY 用 openai，
# 都没有则回退到内置离线 mock 模型（无网络依赖，用于体验完整流程）
MODEL_PROVIDER=

# DashScope（通义千问，推荐中文客服场景）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# OpenAI / OpenAI 兼容端点（可指向任意 base_url）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ============ RAG 知识库检索配置 ============
# 向量化后端: dashscope / none
# 留空则自动判断: 有 DASHSCOPE_API_KEY 用 dashscope，否则 none（退回纯词面检索，离线仍可跑）
EMBED_PROVIDER=
# Embedding 模型名（DashScope OpenAI 兼容端点）
EMBED_MODEL=qwen3.7-text-embedding-flash
# 兼容端点 base_url，默认阿里云百炼
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次 Embedding 请求超时（秒）与批量条数上限
EMBED_TIMEOUT=15
EMBED_BATCH_SIZE=10
# 最终返回的知识条数，以及混合得分下限（低于视为未命中）
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
# 稠密向量权重 alpha（0~1），(1-alpha) 为词面关键词权重
RAG_ALPHA=0.7

# ---- Agentic RAG：查询改写 + 精排 + 置信度自检 ----
# 是否对电商口语做同义 multi-query 扩展再召回（纯规则、离线可用；关掉则只用原句）
QUERY_REWRITE_ENABLED=true
# 进入精排的候选短列表大小（放宽召回、由精排收敛到 RAG_TOP_K）
RAG_RECALL_K=8
# 精排后端: dashscope / none。留空自动判断：配了 RERANK_MODEL 且有 DASHSCOPE_API_KEY 就启用，
# 否则 none（跳过精排，沿用混合召回原序，离线仍可跑、结果确定）
RERANK_PROVIDER=
# 精排模型名（DashScope 原生 text-rerank）
RERANK_MODEL=gte-rerank-v2
# 精排接口完整 URL（注意是原生 services 路径，非 compatible-mode）
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 精排请求超时（秒）
RERANK_TIMEOUT=8
# 精排得分下限：高于视为 high 置信，低于标 low 并提示澄清 / 转人工（仅精排开启时生效）
RAG_HIGH_CONF_BAR=0.20

# ---- Agentic RAG：反思式检索（Self-RAG / CRAG：检索评估器 + 改写重检）----
# 低置信时是否让模型判「资料够不够答」、不足则改写重检一次（有界，控制延迟）。
# 留空自动判断：配了 RAG_REFLECT_MODEL + RAG_REFLECT_BASE_URL 且有 DASHSCOPE_API_KEY 就启用
RAG_REFLECT_ENABLED=
# 反思评估器用的对话模型名（走 OpenAI 兼容 /chat/completions，复用 DASHSCOPE_API_KEY）
RAG_REFLECT_MODEL=
# 兼容端点 base_url（阿里云百炼 compatible-mode）
RAG_REFLECT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 单次反思请求超时（秒）
RAG_REFLECT_TIMEOUT=8
# 最多反思/重检轮次（默认 1：一次评估 + 必要时一次改写重检）
RAG_REFLECT_MAX_ROUNDS=1

# ============ 端到端 Agent 评测（Eval） ============
# 被测与裁判都走真实模型；裁判复用上方 DASHSCOPE_API_KEY
# 裁判模型名（OpenAI 兼容端点）
EVAL_JUDGE_MODEL=
# 裁判接口 base_url（compatible-mode，评测会调 /chat/completions）
EVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 裁判请求超时（秒）：裁判是推理型模型、耗时波动大（实测 7~30s）。超时不记失败，
# 而是让该维度不计入分母，所以宁可给足余量，也不要让判定被截断
EVAL_JUDGE_TIMEOUT=120
# 单条 case 驱动超时（秒）：真实调用卡住时只算该条失败，不拖垮整轮评测
EVAL_CASE_TIMEOUT=90
# 采样温度：0 最可复现
EVAL_TEMPERATURE=0
# 单次评测最多跑多少条 golden case，0=全量
EVAL_MAX_CASES=0
# 是否按 case 指纹缓存原始输出（关掉则每次重新计费）
EVAL_CACHE_ENABLED=true

# ============ 多智能体（监督者 + 专家子 agent，agent-as-tool）============
# 打开后主链路改为：入口监督者只判意图，把知识检索/物流/退款售后/导购交易委派给能独立推理的专家子 agent。
# 默认关闭走单 agent，保证离线 clone 与既有测试不受影响（端到端评测固定走多 agent，不受此开关影响）。
MULTI_AGENT_ENABLED=false
# 专家子 agent 单次委派的最多"推理-行动"轮次
SPECIALIST_MAX_ITERS=6
# 监督者（只做路由与转述）单独用的模型，留空=与主模型同款。可填更快的模型降低首 token 延迟
SUPERVISOR_MODEL=
# 只委派一个专家时直接采用其答案，跳过监督者的第二次模型调用（跨域多专家委派不受影响）
PASSTHROUGH_SINGLE_DELEGATION=true

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
# 会话闲置多久后回收（分钟）
SESSION_TTL_MINUTES=120
# 单个会话最大保留在内存中的数量
MAX_SESSIONS=200

# ============ 品牌配置 ============
# 商城品牌名与客服展示名，留空则用代码默认值
BRAND_NAME=Volcano
AGENT_NAME=小V

# ============ 上下文与推理轮次策略 ============
# 上下文占模型窗口的比例超过 CONTEXT_TRIGGER_RATIO 时触发压缩（SDK 上限 0.9）
CONTEXT_TRIGGER_RATIO=0.7
# 压缩后保留的上下文比例，必须小于 CONTEXT_TRIGGER_RATIO
CONTEXT_RESERVE_RATIO=0.2
# 压缩阈值之前的预警缓冲区，必须小于 CONTEXT_TRIGGER_RATIO
CONTEXT_BUFFER_RATIO=0.15
# 单条工具结果的 token 上限，超出即截断
TOOL_RESULT_LIMIT=4000
# 一轮回复内最多的"推理-行动"轮次
MAX_REACT_ITERS=12
# 单轮回复的加权 token 预算（输入+输出）；超出后注入收尾提示并禁用工具
REPLY_TOKEN_BUDGET=32000
# 输出 token 的权重（通常比输入贵），用于加权计算预算消耗
REPLY_OUTPUT_TOKEN_WEIGHT=2.0